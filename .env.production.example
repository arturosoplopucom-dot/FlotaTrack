# Copiar a .env y completar antes de docker compose up

# Base de datos
POSTGRES_DB=flotatrack
POSTGRES_USER=postgres
POSTGRES_PASSWORD=pon-aqui-una-clave-segura-minimo-20-caracteres

# API
JWT_SECRET=pon-aqui-un-secreto-muy-largo-y-aleatorio-para-jwt
JWT_EXPIRES_IN=7d
CLIENT_URL=https://tudominio.pe

# Puerto web (80 para HTTP, cambiar a 443 si usas HTTPS con proxy)
WEB_PORT=80

# Email para alertas automáticas (opcional — sin esto el cron corre pero no envía)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu@gmail.com
SMTP_PASS=tu-app-password-de-gmail
EMAIL_FROM=FlotaTrack <noreply@tudominio.pe>
